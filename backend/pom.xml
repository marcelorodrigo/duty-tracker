<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.dutytracker</groupId>
    <artifactId>duty-tracker-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>duty-tracker-backend</name>
    <description>On-Call Hours Tracker — Spring Boot 4 REST API</description>

    <properties>
        <java.version>25</java.version>
        <org.mapstruct.version>1.6.3</org.mapstruct.version>
        <de.focus-shift.version>2.18.0</de.focus-shift.version>
        <sonar.organization>marcelorodrigo</sonar.organization>
        <sonar.projectKey>marcelorodrigo_duty-tracker-backend</sonar.projectKey>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Testcontainers BOM for version management -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>2.0.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- OpenAPI/Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: Spring Boot 4 auto-configuration + core + PostgreSQL support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Dutch public holidays -->
        <dependency>
            <groupId>de.focus-shift</groupId>
            <artifactId>jollyday-core</artifactId>
            <version>${de.focus-shift.version}</version>
        </dependency>
        <dependency>
            <groupId>de.focus-shift</groupId>
            <artifactId>jollyday-jaxb</artifactId>
            <version>${de.focus-shift.version}</version>
        </dependency>

        <!-- Bean Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${org.mapstruct.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- DataJpa slice testing (required for @DataJpaTest in Spring Boot 4) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- WebMvc slice testing (required for @WebMvcTest in Spring Boot 4) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>5.7.0.6970</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${org.mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <java>
                        <excludes>
                            <exclude>**/generated-sources/**</exclude>
                        </excludes>
                        <importOrder/>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                        <cleanthat/>
                        <palantirJavaFormat>
                            <version>2.90.0</version>
                            <style>PALANTIR</style>
                            <formatJavadoc>false</formatJavadoc>
                        </palantirJavaFormat>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes>
                        <exclude>com/github/marcelorodrigo/dutytracker/infrastructure/config/JpaAuditingConfiguration.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.24.0</version>
                <executions>
                    <execution>
                        <id>generate-api-interfaces</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/openapi.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <generateModels>false</generateModels>
                            <apiPackage>com.github.marcelorodrigo.dutytracker.gateway.api</apiPackage>
                            <modelPackage>com.github.marcelorodrigo.dutytracker.gateway.api.model</modelPackage>
                            <importMappings>
                                <importMapping>CreateEngineerProfileRequest=com.github.marcelorodrigo.dutytracker.usecase.request.profile.CreateEngineerProfileRequest</importMapping>
                                <importMapping>UpdateEngineerProfileRequest=com.github.marcelorodrigo.dutytracker.usecase.request.profile.UpdateEngineerProfileRequest</importMapping>
                                <importMapping>EngineerProfileResponse=com.github.marcelorodrigo.dutytracker.usecase.response.profile.EngineerProfileResponse</importMapping>
                                <importMapping>CreateCompensationRateRequest=com.github.marcelorodrigo.dutytracker.usecase.request.compensation.CreateCompensationRateRequest</importMapping>
                                <importMapping>UpdateCompensationRateRequest=com.github.marcelorodrigo.dutytracker.usecase.request.compensation.UpdateCompensationRateRequest</importMapping>
                                <importMapping>CompensationRateResponse=com.github.marcelorodrigo.dutytracker.usecase.response.compensation.CompensationRateResponse</importMapping>
                                <importMapping>CompensationRateTableResponse=com.github.marcelorodrigo.dutytracker.usecase.response.compensation.CompensationRateTableResponse</importMapping>
                                <importMapping>CreateOnCallPeriodRequest=com.github.marcelorodrigo.dutytracker.usecase.request.oncall.CreateOnCallPeriodRequest</importMapping>
                                <importMapping>UpdateOnCallPeriodRequest=com.github.marcelorodrigo.dutytracker.usecase.request.oncall.UpdateOnCallPeriodRequest</importMapping>
                                <importMapping>OnCallPeriodResponse=com.github.marcelorodrigo.dutytracker.usecase.response.oncall.OnCallPeriodResponse</importMapping>
                                <importMapping>OnCallPeriodListResponse=com.github.marcelorodrigo.dutytracker.usecase.response.oncall.OnCallPeriodListResponse</importMapping>
                                <importMapping>HolidayResponse=com.github.marcelorodrigo.dutytracker.usecase.response.oncall.HolidayResponse</importMapping>
                                <importMapping>OnCallDayEntriesResponse=com.github.marcelorodrigo.dutytracker.usecase.response.oncall.OnCallDayEntriesResponse</importMapping>
                                <importMapping>OnCallPeriodReportResponse=com.github.marcelorodrigo.dutytracker.usecase.response.oncall.OnCallPeriodReportResponse</importMapping>
                                <importMapping>EarningsResponse=com.github.marcelorodrigo.dutytracker.usecase.response.oncall.EarningsResponse</importMapping>
                                <importMapping>LogIncidentRequest=com.github.marcelorodrigo.dutytracker.usecase.request.incident.LogIncidentRequest</importMapping>
                                <importMapping>UpdateIncidentBody=com.github.marcelorodrigo.dutytracker.gateway.controllers.incident.UpdateIncidentBody</importMapping>
                                <importMapping>IncidentResponse=com.github.marcelorodrigo.dutytracker.usecase.response.incident.IncidentResponse</importMapping>
                                <importMapping>IncidentListResponse=com.github.marcelorodrigo.dutytracker.usecase.response.incident.IncidentListResponse</importMapping>
                                <importMapping>OvertimeEntriesResponse=com.github.marcelorodrigo.dutytracker.usecase.response.incident.OvertimeEntriesResponse</importMapping>
                            </importMappings>
                            <configOptions>
                                <generateApis>true</generateApis>
                                <interfaceOnly>true</interfaceOnly>
                                <library>spring-boot</library>
                                <useSpringBoot4>true</useSpringBoot4>
                                <useTags>true</useTags>
                                <openApiNullable>false</openApiNullable>
                                <skipDefaultInterface>true</skipDefaultInterface>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
