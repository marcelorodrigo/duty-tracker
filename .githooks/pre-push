#!/bin/sh

set -eu

zero_oid=0000000000000000000000000000000000000000
frontend_changed=false
default_remote_ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD || true)

while read -r _local_ref local_oid _remote_ref remote_oid; do
  if [ "$local_oid" = "$zero_oid" ]; then
    continue
  fi

  if [ "$remote_oid" = "$zero_oid" ]; then
    if [ -z "$default_remote_ref" ]; then
      frontend_changed=true
      break
    fi

    base_oid=$(git merge-base "$local_oid" "$default_remote_ref")
  else
    base_oid=$remote_oid
  fi

  if git diff --name-only "$base_oid" "$local_oid" -- \
    frontend/ \
    .github/workflows/frontend-ci.yml \
    .github/dependabot.yml \
    .githooks/pre-push | grep -q .; then
    frontend_changed=true
    break
  fi
done

if [ "$frontend_changed" = false ]; then
  exit 0
fi

repository_root=$(git rev-parse --show-toplevel)

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm 11.1.3 is required to run frontend pre-push checks." >&2
  exit 1
fi

echo "Frontend changes detected; running lint and typecheck before push."

cd "$repository_root/frontend"
pnpm lint
pnpm typecheck
