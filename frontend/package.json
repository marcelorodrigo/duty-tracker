{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle:analyze": "nuxt analyze --no-serve",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && node scripts/install-git-hooks.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.117",
    "@iconify-json/simple-icons": "^1.2.91",
    "@internationalized/date": "^3.12.2",
    "@nuxt/ui": "^4.9.0",
    "nuxt": "^4.4.8",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "happy-dom": "^20.10.6",
    "typescript": "6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": ">=26 <27",
    "pnpm": "11.1.3"
  },
  "packageManager": "pnpm@11.1.3"
}
